// Highlights are generated by the actual nearby PointLight2D, never a sun sweep.
// A zero default preserves the other maps that share these surface shaders.
uniform float specular_strength : hint_range(0.0,1.0) = 0.0;
uniform float specular_power : hint_range(2.0,64.0) = 24.0;
void light() {
	float diffuse = max(dot(NORMAL,LIGHT_DIRECTION),0.0);
	vec3 half_direction = normalize(LIGHT_DIRECTION+vec3(0.0,0.0,1.0));
	float specular = pow(max(dot(NORMAL,half_direction),0.0),specular_power)*specular_strength;
	LIGHT = vec4((COLOR.rgb*diffuse+vec3(specular))*LIGHT_COLOR.rgb*LIGHT_ENERGY,LIGHT_COLOR.a);
}
